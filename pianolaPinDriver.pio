; A single state machine drives the four BNCs, the onboard LED and the two
; external status-LED channels.
; Their GPIOs are nonconsecutive, so each FIFO entry has a zero-based duration
; word followed by a GPIO mask word.
; The 12X system clock divider gives an 80 ns PIO cycle at 150 MHz.
; One Pianola tick is 32 PIO cycles (2.56 us). The last tick includes the
; instructions that check for and load the next entry. Only OUT changes the
; pins, so the current pattern stays latched while the state machine waits.

.program pinDriver
.mov_status txfifo < 2                  ; STATUS is all ones below two TX words and zero otherwise.
.wrap_target
waitForTrigger:
    mov y, status                       ; Copy the FIFO status to Y so the branch can test it.
    jmp !y issueTrigger                 ; Y is zero once both the duration and the mask are available.
    jmp waitForTrigger                  ; Poll again when there is no complete entry yet.

durationTick:
    jmp countdown [5]                   ; Jump back to test X. These 6 cycles plus the taken countdown's 26 make one tick.

; The FIFO check guarantees that both blocking pulls can proceed.
issueTrigger:
    pull                                ; Pull the duration word from the TX FIFO into the output shift register.
    mov x, osr                          ; Copy the zero-based countdown into scratch register X.
    pull                                ; Pull the GPIO mask into the output shift register.
    out pins, 32                        ; Apply the whole new mask in one write.
countdown:
    jmp x-- durationTick [25]            ; Test X before decrementing it. A nonzero value branches for another full tick.
    ; Last tick: OUT (1) + countdown (26) + FIFO check (2) + load (3).
    mov y, status                       ; X reached zero. Check whether the next pair is already queued.
    jmp !y issueTrigger                 ; If ready, spend the last three cycles loading it before the next OUT.
    nop [2]                             ; With no successor, spend those three cycles holding the current mask.
    jmp waitForTrigger                  ; Return to the idle PC the firmware checks for completion.
.wrap


;; write the sdk
% c-sdk{
static inline void pinDriver_program_init(PIO pioBlock, uint stateMachine, uint stateMachineOffset, uint firstPin, uint pinSpan, uint32_t outputGpioMask, uint32_t clkDivisorFP)
    {
        // helper function for the pinDriver.pio program
        // configure the state machine using a bog standard configuration
        pio_sm_config config = pinDriver_program_get_default_config(stateMachineOffset);

        // Map OUT to the GPIO span that contains the sequence outputs.
        sm_config_set_out_pins(&config, firstPin, pinSpan);

        // set clock divider
        // clock divider is 16:8 Fixed Point integer
        uint16_t clkDivisorINT = (clkDivisorFP >> 8) & 0xFFFF;
        uint8_t clkDivisorFRAC = clkDivisorFP & 0xFF;
        sm_config_set_clkdiv_int_frac8(&config, clkDivisorINT, clkDivisorFRAC);

        // Initialise the output levels and directions before handing the pins to PIO.
        pio_sm_init(pioBlock, stateMachine, stateMachineOffset, &config);
        pio_sm_set_pins_with_mask(pioBlock, stateMachine, 0, outputGpioMask);
        pio_sm_set_pindirs_with_mask(pioBlock, stateMachine, outputGpioMask, outputGpioMask);
        for (uint pin = firstPin; pin < firstPin + pinSpan; pin++)
        {
            if (outputGpioMask & (1u << pin))
            {
                pio_gpio_init(pioBlock, pin);
            }
        }
    }    
%}
